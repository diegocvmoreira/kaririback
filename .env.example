APP_NAME=Kariri
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.kariri.app.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@kariri.app.br
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@kariri.app.br"
MAIL_FROM_NAME="Kariri"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Origens extras liberadas no CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=

# --- Frontend / CORS ---
# URL pública do frontend (usada no link do e-mail de recuperação de senha). SEM barra no final.
FRONTEND_URL=https://kariri.app.br
# Origens extras liberadas no CORS, separadas por vírgula (ex.: URL publicada no AI Studio)
CORS_ALLOWED_ORIGINS=https://kariri.app.br,https://www.kariri.app.br

# --- Cloudflare Turnstile (antispam de login/cadastro/esqueci-senha) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- IBGE (busca de municípios) ---
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1
